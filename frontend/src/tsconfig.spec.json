{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../out-tsc/spec",
    "module": "commonjs",
    // zone.js cannot patch native async/await, which the CDK test harnesses rely on
    "target": "ES2016",
    "baseUrl": "..",
    "esModuleInterop": true,
    "isolatedModules": true,
    "types": ["jest", "node"]
  },
  "files": ["polyfills.ts"],
  "include": ["**/*.spec.ts", "**/*.d.ts"]
}
